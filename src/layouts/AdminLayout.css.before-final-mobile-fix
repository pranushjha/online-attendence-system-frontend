/* =========================================================
   ATTENDANCE SYSTEM — ADMIN LAYOUT
   OLIVE / SAGE DESIGN
========================================================= */

.admin-layout {
    min-height: 100vh;
    display: flex;
    background: var(--background);
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
    width: 260px;
    min-height: 100vh;

    display: flex;
    flex-direction: column;

    flex-shrink: 0;

    position: relative;
    z-index: 1000;

    background: var(--primary);
    color: #FFFFFF;

    border-right: 1px solid rgba(255,255,255,0.08);

    box-shadow:
        8px 0 30px rgba(64, 78, 59, 0.10);

    transition:
        transform 0.3s ease,
        width 0.3s ease;
}


/* =========================================================
   BRAND
========================================================= */

.sidebar-brand {
    min-height: 105px;

    padding: 25px 22px;

    display: flex;
    align-items: center;

    gap: 13px;

    border-bottom: 1px solid rgba(255,255,255,0.10);
}

.sidebar-brand h2 {
    margin: 0;

    color: #FFFFFF;

    font-size: 21px;
    font-weight: 800;

    letter-spacing: -0.02em;
}

.sidebar-brand span {
    display: block;

    margin-top: 4px;

    color: rgba(255,255,255,0.68);

    font-size: 12px;
    font-weight: 500;
}


/* =========================================================
   BRAND ICON
========================================================= */

.brand-icon {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: var(--primary-light);

    color: #FFFFFF;

    font-size: 19px;

    box-shadow:
        0 8px 20px rgba(64,78,59,0.20);
}


/* =========================================================
   NAVIGATION
========================================================= */

.sidebar-nav {
    flex: 1;

    padding: 22px 14px;

    overflow-y: auto;
}

.sidebar-section-label {
    margin: 0 10px 12px;

    color: rgba(255,255,255,0.48);

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 0.12em;
}

.nav-item {
    min-height: 46px;

    display: flex;
    align-items: center;

    gap: 13px;

    margin-bottom: 6px;

    padding: 0 14px;

    border-radius: 10px;

    color: rgba(255,255,255,0.68);

    font-size: 14px;
    font-weight: 600;

    text-decoration: none;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.nav-item:hover {
    background: rgba(255,255,255,0.09);

    color: #FFFFFF;

    transform: translateX(2px);
}

.nav-item.active {
    color: #FFFFFF;

    background: var(--primary-light);

    box-shadow:
        0 7px 18px rgba(64,78,59,0.20);
}

.nav-icon {
    width: 19px;

    display: flex;
    justify-content: center;

    flex-shrink: 0;
}

.nav-icon svg {
    width: 18px;
    height: 18px;
}


/* =========================================================
   SIDEBAR BOTTOM
========================================================= */

.sidebar-bottom {
    padding: 18px;

    border-top: 1px solid rgba(255,255,255,0.10);
}

.sidebar-user {
    min-width: 0;

    display: flex;
    flex-direction: column;

    margin-bottom: 15px;

    padding: 11px;

    border-radius: 12px;

    background: rgba(255,255,255,0.07);
}

.sidebar-user strong {
    overflow: hidden;

    color: #FFFFFF;

    font-size: 13px;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.sidebar-user span {
    margin-top: 3px;

    color: rgba(255,255,255,0.62);

    font-size: 11px;
}


/* =========================================================
   LOGOUT
========================================================= */

.logout-button {
    width: 100%;

    min-height: 43px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px;

    background: transparent;

    color: rgba(255,255,255,0.76);

    font-size: 13px;
    font-weight: 700;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
}

.logout-button:hover {
    background: rgba(255,255,255,0.10);

    border-color: rgba(255,255,255,0.25);

    color: #FFFFFF;
}

.logout-button svg {
    width: 17px;
    height: 17px;
}


/* =========================================================
   MAIN CONTENT
========================================================= */

.layout-content {
    flex: 1;

    min-width: 0;
    min-height: 100vh;

    overflow-x: hidden;

    background: var(--background);
}


/* =========================================================
   MOBILE HEADER
========================================================= */

.mobile-header {
    display: none;
}


/* =========================================================
   MOBILE CLOSE BUTTON
========================================================= */

.mobile-close-button {
    display: none;
}


/* =========================================================
   OVERLAY
========================================================= */

.sidebar-overlay {
    display: none;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 900px) {

    .sidebar {
        width: 260px;

        position: fixed;

        top: 0;
        left: 0;

        transform: translateX(-100%);

        box-shadow:
            10px 0 35px rgba(39,52,47,0.22);
    }

    .sidebar.sidebar-open {
        transform: translateX(0);
    }

    .mobile-header {
        height: 64px;

        display: flex;
        align-items: center;

        gap: 14px;

        padding: 0 18px;

        position: fixed;

        top: 0;
        left: 0;
        right: 0;

        z-index: 900;

        background: var(--primary);

        color: #FFFFFF;

        box-shadow:
            0 4px 18px rgba(64,78,59,0.12);
    }

    .mobile-menu-button {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 9px;

        background: rgba(255,255,255,0.08);

        color: #FFFFFF;
    }

    .mobile-menu-button svg {
        width: 20px;
        height: 20px;
    }

    .mobile-header-title {
        display: flex;
        flex-direction: column;
    }

    .mobile-header-title strong {
        font-size: 15px;
        line-height: 1.2;
    }

    .mobile-header-title span {
        margin-top: 2px;

        color: rgba(255,255,255,0.65);

        font-size: 10px;
    }

    .mobile-close-button {
        width: 36px;
        height: 36px;

        display: flex;
        align-items: center;
        justify-content: center;

        position: absolute;

        top: 17px;
        right: 14px;

        border: 0;

        background: transparent;

        color: rgba(255,255,255,0.75);
    }

    .mobile-close-button svg {
        width: 20px;
        height: 20px;
    }

    .sidebar-overlay {
        display: block;

        position: fixed;

        inset: 0;

        z-index: 950;

        background: rgba(39,52,47,0.55);
    }

    .layout-content {
        padding-top: 64px;
    }
}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 480px) {

    .sidebar {
        width: 245px;
    }

    .mobile-header {
        padding: 0 14px;
    }
}
