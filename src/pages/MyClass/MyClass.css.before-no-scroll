.my-class-page {
    padding: 40px;
    min-height: 100vh;
    background: #E6E6E6;
}

.my-class-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 30px;
}

.my-class-label {
    color: #404E3B;
    font-weight: 600;
    margin-bottom: 8px;
}

.my-class-header h1 {
    margin: 0;
    font-size: 36px;
}

.my-class-header p {
    color: #6C8480;
    font-size: 16px;
}

.my-class-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.my-class-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 16px;
    border: none;
    border-radius: 8px;
    background: #404E3B;
    color: white;
    font-weight: 600;
    cursor: pointer;
}

.my-class-button:hover {
    background: #344130;
}

.my-class-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.my-class-error {
    margin-bottom: 20px;
    padding: 15px 18px;
    background: #FBEAEA;
    border: 1px solid #E7B8B8;
    border-radius: 10px;
    color: #C94A4A;
}

.upload-success {
    margin-bottom: 20px;
    padding: 18px;
    background: #E8F1E8;
    border: 1px solid #B9CDB9;
    border-radius: 10px;
    color: #3F7D4A;
}

.upload-summary {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 10px;
}

.class-information,
.my-class-students {
    background: white;
    border: 1px solid #D6D9D5;
    border-radius: 14px;
    padding: 25px;
    margin-bottom: 30px;
}

.class-information h2,
.my-class-students h2 {
    margin-top: 0;
}

.class-information p {
    color: #6C8480;
}

.students-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 15px;
}

.students-section-header span {
    color: #6C8480;
    font-size: 14px;
}

.my-class-table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.my-class-table {
    width: 100%;
    border-collapse: collapse;
}

.my-class-table th,
.my-class-table td {
    padding: 15px;
    text-align: left;
    border-bottom: 1px solid #D6D9D5;
}

.my-class-table th {
    color: #6C8480;
    font-size: 13px;
    text-transform: uppercase;
}

.student-status {
    display: inline-flex;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
}

.student-status.active {
    background: #E8F1E8;
    color: #3F7D4A;
}

.student-status.inactive {
    background: #FBEAEA;
    color: #A43D3D;
}

.empty-class {
    padding: 30px 10px;
    text-align: center;
    color: #6C8480;
}

.my-class-loading {
    padding: 40px;
}

.my-class-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(15, 23, 42, 0.55);
}

.my-class-modal {
    width: 100%;
    max-width: 500px;
    background: white;
    border-radius: 14px;
    overflow: hidden;
}

.my-class-modal-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px;
    border-bottom: 1px solid #D6D9D5;
}

.my-class-modal-header h2 {
    margin: 0;
}

.my-class-modal-header p {
    margin-bottom: 0;
    color: #6C8480;
}

.my-class-close {
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: #6C8480;
    cursor: pointer;
}

.my-class-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px;
}

.my-class-form label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    color: #4F625D;
    font-weight: 600;
}

.my-class-form input {
    padding: 11px 12px;
    border: 1px solid #C8CEC8;
    border-radius: 8px;
    outline: none;
}

.my-class-form input:focus {
    border-color: #404E3B;
}

.assigned-class-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    background: #E6E6E6;
    border-radius: 8px;
}

.assigned-class-field span {
    color: #6C8480;
    font-size: 13px;
}

.my-class-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 5px;
}

.my-class-cancel,
.my-class-save {
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
}

.my-class-cancel {
    border: 1px solid #C8CEC8;
    background: white;
    color: #6C8480;
}

.my-class-save {
    border: none;
    background: #404E3B;
    color: white;
}

.my-class-save:disabled,
.my-class-cancel:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

@media (max-width: 700px) {

    .my-class-page {
        padding: 20px 12px;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    .my-class-header {
        flex-direction: column;
        gap: 15px;
        margin-bottom: 20px;
        width: 100%;
    }

    .my-class-header h1 {
        font-size: 28px;
        line-height: 1.2;
    }

    .my-class-header p {
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 0;
    }

    .my-class-actions {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .my-class-button {
        width: 100%;
        flex: none;
        box-sizing: border-box;
    }

    .class-information,
    .my-class-students {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        padding: 18px 14px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .class-information h2,
    .my-class-students h2 {
        font-size: 20px;
    }

    .students-section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
    }

    .my-class-table-wrapper {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .my-class-table {
        width: max-content;
        min-width: 600px;
    }

    .my-class-table th,
    .my-class-table td {
        padding: 11px 10px;
        white-space: nowrap;
        font-size: 13px;
    }

    .my-class-modal-overlay {
        padding: 12px;
    }

    .my-class-modal {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    .my-class-modal-header {
        padding: 18px;
    }

    .my-class-form {
        padding: 18px;
    }

    .my-class-modal-actions {
        flex-direction: column-reverse;
    }

    .my-class-cancel,
    .my-class-save {
        width: 100%;
        box-sizing: border-box;
    }
}

@media (max-width: 400px) {

    .my-class-page {
        padding: 16px 10px;
    }

    .class-information,
    .my-class-students {
        padding: 15px 12px;
        border-radius: 10px;
    }

    .my-class-header h1 {
        font-size: 25px;
    }

    .my-class-table {
        min-width: 560px;
    }

    .my-class-table th,
    .my-class-table td {
        padding: 10px 8px;
        font-size: 12px;
    }
}
/* ==========================================================
   MOBILE RESPONSIVE GLOBAL OVERRIDE
   ========================================================== */

@media (max-width: 768px) {

    .my-class-page {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
        overflow-x: hidden !important;
    }

    .class-information,
    .my-class-students {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    .my-class-table-wrapper {
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch !important;
    }
}
