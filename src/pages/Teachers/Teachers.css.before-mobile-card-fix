/* =========================================================
   TEACHERS PAGE
========================================================= */

.teachers-page {
    min-height: 100vh;

    padding: 40px 46px;

    background:
        radial-gradient(
            circle at 85% 0%,
            rgba(64, 78, 59, 0.07),
            transparent 30%
        ),
        #E6E6E6;

    box-sizing: border-box;
}


/* =========================================================
   HEADER
========================================================= */

.teachers-header {
    width: 100%;
    max-width: 1280px;

    margin: 0 auto 28px;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 24px;
}

.teachers-heading {
    min-width: 0;
}

.teachers-label {
    margin: 0 0 7px;

    color: #7B9669;

    font-size: 12px;
    font-weight: 800;

    letter-spacing: 0.12em;
}

.teachers-header h1 {
    margin: 0;

    color: #27342F;

    font-size: 38px;
    line-height: 1.12;

    letter-spacing: -0.035em;
}

.teachers-description {
    margin: 9px 0 0;

    color: #6C8480;

    font-size: 15px;
    line-height: 1.5;
}


/* =========================================================
   ADD BUTTON
========================================================= */

.add-teacher-button {
    min-height: 46px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    padding: 0 18px;

    border: none;
    border-radius: 10px;

    background: #404E3B;

    color: white;

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 8px 18px rgba(64, 78, 59, 0.18);

    transition:
        background 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.add-teacher-button:hover {
    background: #344130;

    transform: translateY(-1px);

    box-shadow:
        0 10px 22px rgba(64, 78, 59, 0.22);
}

.add-teacher-button:active {
    transform: translateY(0);
}


/* =========================================================
   ERROR
========================================================= */

.teachers-error {
    width: 100%;
    max-width: 1280px;

    box-sizing: border-box;

    margin: 0 auto 20px;

    padding: 14px 16px;

    border: 1px solid #E7B8B8;
    border-radius: 10px;

    background: #FBEAEA;

    color: #C94A4A;

    font-size: 14px;
    line-height: 1.45;
}


/* =========================================================
   CARD
========================================================= */

.teachers-card {
    width: 100%;
    max-width: 1280px;

    margin: 0 auto;

    overflow: hidden;

    border: 1px solid #D6D9D5;

    border-radius: 16px;

    background: white;

    box-shadow:
        0 6px 22px rgba(15, 23, 42, 0.05);
}


/* =========================================================
   TABLE
========================================================= */

.teachers-table-wrapper {
    width: 100%;

    overflow-x: auto;

    -webkit-overflow-scrolling: touch;
}

.teachers-table {
    width: 100%;

    min-width: 800px;

    border-collapse: collapse;
}

.teachers-table th {
    padding: 15px 20px;

    background: #E6E6E6;

    border-bottom: 1px solid #D6D9D5;

    color: #6C8480;

    font-size: 11px;
    font-weight: 800;

    text-align: left;

    text-transform: uppercase;

    letter-spacing: 0.07em;

    white-space: nowrap;
}

.teachers-table td {
    padding: 16px 20px;

    border-bottom: 1px solid #F3F3F1;

    color: #6C8480;

    font-size: 14px;

    vertical-align: middle;
}

.teachers-table tbody tr {
    transition: background 0.15s ease;
}

.teachers-table tbody tr:hover {
    background: #F3F3F1;
}

.teachers-table tbody tr:last-child td {
    border-bottom: none;
}


/* =========================================================
   TEACHER NAME
========================================================= */

.teacher-name-cell {
    display: flex;
    align-items: center;

    gap: 11px;

    min-width: 180px;
}

.teacher-list-avatar {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 10px;

    background: #E8EFE5;

    color: #404E3B;

    font-size: 11px;
    font-weight: 800;
}

.teacher-name-cell strong {
    color: #27342F;

    font-size: 14px;
    font-weight: 700;
}


/* =========================================================
   EMAIL
========================================================= */

.teacher-email {
    color: #6C8480;

    white-space: nowrap;
}


/* =========================================================
   ASSIGNED CLASS
========================================================= */

.assigned-class-badge {
    display: inline-flex;
    align-items: center;

    padding: 6px 10px;

    border-radius: 7px;

    background: #F3F3F1;

    color: #4F625D;

    font-size: 12px;
    font-weight: 700;

    white-space: nowrap;
}

.teacher-not-assigned {
    color: #8A9894;

    font-size: 13px;
}


/* =========================================================
   ROLE
========================================================= */

.teacher-role-badge {
    display: inline-flex;

    padding: 6px 10px;

    border-radius: 999px;

    background: #E8EFE5;

    color: #404E3B;

    font-size: 11px;
    font-weight: 800;

    text-transform: capitalize;
}


/* =========================================================
   ACTION BUTTONS
========================================================= */

.teacher-action-buttons {
    display: flex;

    gap: 7px;
}

.teacher-edit-button,
.teacher-delete-button {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 8px;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease;
}

.teacher-edit-button {
    border: 1px solid #D6D9D5;

    background: #F3F3F1;

    color: #404E3B;
}

.teacher-delete-button {
    border: 1px solid #FBEAEA;

    background: #FBEAEA;

    color: #C94A4A;
}

.teacher-edit-button:hover {
    background: #E8EFE5;

    border-color: #B9C8B0;
}

.teacher-delete-button:hover {
    background: #FBEAEA;

    border-color: #E7B8B8;
}

.teacher-edit-button:disabled,
.teacher-delete-button:disabled {
    opacity: 0.5;

    cursor: not-allowed;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.teachers-empty {
    min-height: 360px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    padding: 40px 20px;

    text-align: center;
}

.teachers-empty-icon {
    width: 54px;
    height: 54px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 16px;

    border-radius: 14px;

    background: #E8EFE5;

    color: #7B9669;

    font-size: 22px;
}

.teachers-empty h3 {
    margin: 0;

    color: #27342F;

    font-size: 18px;
}

.teachers-empty p {
    margin: 7px 0 18px;

    color: #6C8480;

    font-size: 14px;
}

.teachers-empty button {
    display: inline-flex;
    align-items: center;

    gap: 8px;

    padding: 10px 15px;

    border: none;
    border-radius: 8px;

    background: #404E3B;

    color: white;

    font-size: 13px;
    font-weight: 700;

    cursor: pointer;
}

.teachers-empty button:hover {
    background: #344130;
}


/* =========================================================
   LOADING
========================================================= */

.teachers-loading {
    min-height: 70vh;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 12px;

    color: #6C8480;

    font-size: 14px;
}

.teachers-loading-spinner {
    width: 28px;
    height: 28px;

    border: 3px solid #D6D9D5;
    border-top-color: #404E3B;

    border-radius: 50%;

    animation: teachers-spin 0.8s linear infinite;
}

@keyframes teachers-spin {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

}


/* =========================================================
   MODAL OVERLAY
========================================================= */

.teacher-modal-overlay {
    position: fixed;
    inset: 0;

    z-index: 2000;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(15, 23, 42, 0.58);

    backdrop-filter: blur(4px);

    overflow-y: auto;
}


/* =========================================================
   MODAL
========================================================= */

.teacher-modal {
    width: 100%;
    max-width: 520px;

    max-height: calc(100vh - 40px);

    overflow-y: auto;

    border-radius: 16px;

    background: white;

    box-shadow:
        0 25px 70px rgba(15, 23, 42, 0.25);
}


/* =========================================================
   MODAL HEADER
========================================================= */

.teacher-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 20px;

    padding: 23px 24px;

    border-bottom: 1px solid #D6D9D5;
}

.teacher-modal-label {
    margin: 0 0 6px;

    color: #7B9669;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 0.1em;
}

.teacher-modal-header h2 {
    margin: 0;

    color: #27342F;

    font-size: 21px;
}

.teacher-modal-header p:last-child {
    margin: 5px 0 0;

    color: #6C8480;

    font-size: 13px;

    line-height: 1.45;
}

.teacher-modal-close {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border: none;
    border-radius: 8px;

    background: #F3F3F1;

    color: #6C8480;

    cursor: pointer;
}

.teacher-modal-close:hover {
    background: #D6D9D5;

    color: #4F625D;
}

.teacher-modal-close:disabled {
    opacity: 0.5;

    cursor: not-allowed;
}


/* =========================================================
   FORM
========================================================= */

.teacher-form {
    padding: 24px;
}

.teacher-form label {
    display: block;

    margin-bottom: 17px;

    color: #4F625D;

    font-size: 13px;
    font-weight: 700;
}

.teacher-form input,
.teacher-form select {
    width: 100%;

    box-sizing: border-box;

    display: block;

    margin-top: 7px;

    min-height: 46px;

    padding: 0 13px;

    border: 1px solid #D6D9D5;

    border-radius: 9px;

    outline: none;

    background: white;

    color: #27342F;

    font-size: 14px;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.teacher-form input::placeholder {
    color: #8A9894;
}

.teacher-form input:focus,
.teacher-form select:focus {
    border-color: #7B9669;

    box-shadow:
        0 0 0 3px rgba(64, 78, 59, 0.1);
}

.teacher-form-help {
    display: block;

    margin-top: 6px;

    color: #8A9894;

    font-size: 11px;
    font-weight: 400;

    line-height: 1.4;
}

.teacher-class-warning {
    margin: -4px 0 0;

    padding: 10px 12px;

    border-radius: 8px;

    background: #FFF4DD;

    color: #8F641F;

    font-size: 12px;
}


/* =========================================================
   MODAL ACTIONS
========================================================= */

.teacher-modal-actions {
    display: flex;
    justify-content: flex-end;

    gap: 10px;

    margin-top: 24px;
}

.teacher-cancel-button,
.teacher-save-button {
    min-height: 42px;

    padding: 0 16px;

    border-radius: 8px;

    font-size: 13px;
    font-weight: 700;

    cursor: pointer;
}

.teacher-cancel-button {
    border: 1px solid #d1d5db;

    background: white;

    color: #6C8480;
}

.teacher-cancel-button:hover {
    background: #E6E6E6;
}

.teacher-save-button {
    border: none;

    background: #404E3B;

    color: white;
}

.teacher-save-button:hover {
    background: #344130;
}

.teacher-cancel-button:disabled,
.teacher-save-button:disabled {
    opacity: 0.6;

    cursor: not-allowed;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .teachers-page {
        padding: 32px 24px;
    }

    .teachers-header {
        gap: 18px;
    }

}


@media (max-width: 700px) {

    .teachers-page {
        padding: 24px 16px;
    }

    .teachers-header {
        flex-direction: column;
    }

    .add-teacher-button {
        width: 100%;
    }

    .teachers-card {
        border-radius: 12px;
    }

    .teachers-table {
        min-width: 760px;
    }

    .teacher-modal-overlay {
        align-items: flex-start;

        padding: 12px;
    }

    .teacher-modal {
        max-height: calc(100vh - 24px);

        border-radius: 13px;
    }

}


@media (max-width: 480px) {

    .teachers-page {
        padding: 20px 12px;
    }

    .teachers-header h1 {
        font-size: 30px;
    }

    .teachers-description {
        font-size: 14px;
    }

    .teacher-modal-header,
    .teacher-form {
        padding: 19px;
    }

    .teacher-modal-actions {
        flex-direction: column-reverse;
    }

    .teacher-cancel-button,
    .teacher-save-button {
        width: 100%;
    }

}

