    }

    .teachers-table td::before {
        font-size: 10px !important;
        font-weight: 800 !important;
        letter-spacing: .06em !important;
        text-transform: uppercase !important;
        color: #718783 !important;
    }

    .teachers-table td:nth-child(1)::before {
        content: "Teacher";
    }

    .teachers-table td:nth-child(2)::before {
        content: "Email";
    }

    .teachers-table td:nth-child(3)::before {
        content: "Assigned Class";
    }

    .teachers-table td:nth-child(4)::before {
        content: "Role";
    }

    .teachers-table td:nth-child(5)::before {
        content: "Actions";
    }

    .teachers-table td > * {
        min-width: 0 !important;
        max-width: 100% !important;
    }

    .teacher-name-cell,
    .teacher-email,
    .assigned-class-badge,
    .teacher-not-assigned,
    .teacher-role-badge {
        max-width: 100% !important;
        min-width: 0 !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
    }

    .teacher-action-buttons {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 8px !important;
        min-width: 0 !important;
    }

    .teacher-action-buttons button {
        flex-shrink: 0 !important;
    }
}


@media (max-width: 400px) {

    .teachers-page {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    .teachers-table tr {
        padding: 12px 10px !important;
    }

    .teachers-table td {
        grid-template-columns: 92px minmax(0, 1fr) !important;
        gap: 7px !important;
        font-size: 13px !important;
    }

    .teachers-table td::before {
        font-size: 9px !important;
    }
}
